# 复制成 .env 后按需修改。docker-compose.yml 里 api/worker 已经直接注入了这些变量，
# 这个文件主要给本地不经 docker、直接跑 uv run uvicorn 时用。

GALIO_DATABASE_URL=postgresql+psycopg://galio:galio@localhost:5432/galio
GALIO_SQL_ECHO=false

GALIO_NODE_EXPORTER_POLL_SECONDS=30
GALIO_DEVICE_PROBE_POLL_SECONDS=60
GALIO_OFFLINE_AFTER_CONSECUTIVE_FAILURES=3
GALIO_NODE_EXPORTER_PORT=9100

# SSH/Ansible：密钥托管方案未定，见 docs/database-schema.md 设计评审 Q5
GALIO_SSH_PRIVATE_KEY_PATH=/secrets/galio_station_key
GALIO_ANSIBLE_PROJECT_DIR=../ansible

# ansible/inventory/dynamic_inventory.py 用的是原生 psycopg DSN，格式跟上面
# GALIO_DATABASE_URL 不一样（没有 +psycopg），两边都要配置，见该脚本头部注释。
GALIO_INVENTORY_DSN=postgresql://galio:galio@localhost:5432/galio
