{
  "name": "glove-management-system",
  "version": "4.0.0",
  "description": "手套/灵巧手/夹爪库存与机器管理系统 - 企业版(500并发)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "lint": "eslint . --ext .js --max-warnings 1000",
    "lint:fix": "eslint . --ext .js --fix",
    "lint:strict": "eslint . --ext .js --max-warnings 50",
    "test": "node --test tests/unit/*.test.js",
    "test:unit": "node tests/run-unit-tests.js",
    "test:integration": "node test_functional.js",
    "test:stress": "node test_concurrent.js",
    "cluster": "pm2 start ecosystem.config.js",
    "stress": "node test_500users.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f app"
  },
  "keywords": [
    "inventory",
    "management",
    "glove",
    "dexterous-hand",
    "gripper",
    "enterprise",
    "cluster"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.5.17",
    "dotenv": "^17.4.2",
    "mysql2": "^3.22.5",
    "qrcode": "^1.5.4",
    "redis": "^4.6.0",
    "web-push": "^3.6.7",
    "ws": "^8.16.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@bubblewrap/cli": "^1.25.0",
    "eslint": "^8.57.1"
  }
}
